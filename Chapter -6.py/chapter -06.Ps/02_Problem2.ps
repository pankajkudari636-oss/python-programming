Marks1 = int(input("Enter marks : "))
Marks2 = int(input("Enter marks : "))
Marks3 = int(input("Enter marks : "))

# Check for the total precentage
total_precentage = (100)*(Marks1+ Marks2+ Marks3)/300

if(total_precentage>=40 and Marks1>=33 and Marks2>=33 and Marks3>=33):
    print("You are Pass", total_precentage)

else:
    print("You failed, try again next year!", total_precentage)


